# Copy this file to .env and fill in your own local credentials.
# Never commit .env or share database passwords in chat.
SQL_HOST=localhost
SQL_PORT=3306
SQL_DATABASE=ecocompute
SQL_USER=your_mysql_username
SQL_PASSWORD=your_mysql_password

MONGODB_URI=mongodb+srv://replace_with_your_own_uri
MONGODB_DATABASE=ecocompute
