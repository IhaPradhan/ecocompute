{
  "collection": "telemetry_logs",
  "description": "Time-series telemetry readings for EcoCompute server racks",
  "fields": {
    "event_id": {
      "type": "string",
      "required": true,
      "description": "Unique identifier for each telemetry reading"
    },
    "timestamp": {
      "type": "date",
      "required": true,
      "description": "UTC timestamp of the reading"
    },
    "rack_id": {
      "type": "integer",
      "required": true
    },
    "rack_name": {
      "type": "string",
      "required": true
    },
    "zone_id": {
      "type": "integer",
      "required": true
    },
    "zone_name": {
      "type": "string",
      "required": true
    },
    "temperature_c": {
      "type": "number",
      "required": true,
      "minimum": -10,
      "maximum": 100
    },
    "power_draw_kw": {
      "type": "number",
      "required": true,
      "minimum": 0
    },
    "cpu_usage_pct": {
      "type": "number",
      "required": true,
      "minimum": 0,
      "maximum": 100
    },
    "status": {
      "type": "string",
      "required": true,
      "enum": ["normal", "warning", "critical"]
    }
  }
}